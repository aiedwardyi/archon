# Archon Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ==========================================
# Authentication & Security
# ==========================================

# JWT Secret Key - Generate a secure random string for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=archon-dev-secret-change-in-prod

# Optional Google OAuth configuration
# Get from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==========================================
# Optional: AI Model Providers
# ==========================================

# Anthropic Claude
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini / Vertex AI
# Option 1: Use API Key (simpler)
# GENAI_API_KEY=your-google-genai-api-key

# Option 2: Use Vertex AI (recommended for production)
# VERTEX_AI_PROJECT=your-gcp-project-id
# VERTEX_AI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# IBM Watson NLU & Discovery
# Get from: https://cloud.ibm.com/
# WATSON_NLU_API_KEY=your-watson-nlu-api-key
# WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com
# WATSON_DISCOVERY_API_KEY=your-watson-discovery-api-key
# WATSON_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
# WATSON_DISCOVERY_PROJECT_ID=your-discovery-project-id

# OpenAI
# OPENAI_API_KEY=your-openai-api-key

# Local Ollama (for cost-effective evaluation)
# OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# Optional: Model Selection
# ==========================================

# Engineer/Code Generation Model
# Options: claude, gemini, openai
# ENGINEER_MODEL=gemini
# ENGINEER_GEMINI_MODEL=gemini-2.5-flash
# ENGINEER_MODEL=claude
# ENGINEER_CLAUDE_MODEL=claude-opus-4-6

# Design/Image Generation Model
# DESIGN_IMAGE_MODEL=imagen-4.0-ultra-generate-001

# Planning Model
# PLANNER_MODEL=gemini

# ==========================================
# Optional: Feature Flags
# ==========================================

# Provider-free local pipeline. Set false after configuring Gemini or Vertex AI.
OFFLINE_MODE=true

# Scheduler worker identification (for distributed deployments)
# ARCHON_SCHEDULER_WORKER_ID=worker-1

# ==========================================
# Development Settings
# ==========================================

# Flask environment (development/production)
# FLASK_ENV=development

# Enable debug mode (never enable in production!)
# FLASK_DEBUG=0

# Return password reset tokens during development or testing only
# Requires FLASK_ENV=development or Flask TESTING mode
# ARCHON_EXPOSE_RESET_TOKEN=false

# Database path (defaults to archon.db at the repository root)
# DATABASE_PATH=/path/to/archon.db

# ==========================================
# Frontend Configuration
# ==========================================

# Enable public demo mode (frontend-only, no backend)
# VITE_PUBLIC_DEMO_MODE=false

# Consumer frontend API URL
# VITE_API_BASE=http://localhost:5000

# Google OAuth Client ID (for frontend)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==========================================
# Notes
# ==========================================

# 1. Provider-free local use needs no external credentials.
#    Keep OFFLINE_MODE=true and change JWT_SECRET_KEY outside local development.

# 2. Live generation requires:
#    - Google Gemini or Vertex AI for requirements and planning
#    - The selected Engineer Agent provider
#    - Anthropic only when ENGINEER_MODEL=claude

# 3. Optional integrations:
#    - Google OAuth
#    - IBM Watson (for governance and NLU)

# 4. Security:
#    - Never commit this file with real values
#    - Use secure secrets management in production
#    - Rotate keys regularly
#    - Use different keys for dev/staging/prod
